# Copy to .env (never commit .env) and fill in.
# Use ONE provider. GEMINI_API_KEY (Google AI Studio) wins if both are set.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides ("google/" prefix is stripped automatically for the Gemini API)
TEXT_MODEL=google/gemini-2.5-flash
VISION_MODEL=google/gemini-2.5-flash
