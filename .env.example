# Copy to .env (never commit .env) and fill in.
# Use ONE provider. GEMINI_API_KEY (Google AI Studio) wins if both are set.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Models used for the submitted output (cache is keyed on these ids; "google/" prefix optional)
TEXT_MODEL=gemini-3.5-flash-lite
VISION_MODEL=gemini-2.5-flash
